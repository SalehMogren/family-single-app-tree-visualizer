{
  "name": "family-tree",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@family/web",
    "dev:admin": "turbo run dev --filter=@family/admin",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "e2e": "pnpm --filter @family/e2e e2e"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.4",
    "typescript": "5.9.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.6"
  }
}
