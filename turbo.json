{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["DATA_DIR", "ADMIN_PASSWORD", "ADMIN_SECRET", "NEXT_PUBLIC_WEB_URL", "NEXT_PUBLIC_ADMIN_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {}
  }
}
