# Where the JSON data store lives (shared by web + admin). Defaults to <repo>/data
# DATA_DIR=/absolute/path/to/data

# Admin app authentication
ADMIN_PASSWORD=change-me
# Long random string used to sign admin session cookies (openssl rand -hex 32)
ADMIN_SECRET=replace-with-a-long-random-string

# Cross-links between the two apps
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
